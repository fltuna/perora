{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Perora",
  "version": "0.1.0",
  "identifier": "dev.f2a.perora",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; img-src 'self' perora: http://perora.localhost https://i.f2a.dev; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost",
      "dangerousDisableAssetCspModification": ["style-src"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "./windows/hooks.nsh"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEIyMTI4N0Q3MzhBOTU4NTkKUldSWldLazQxNGNTc29IWmVZemZoSUs4VWtNT0s3ZW8xMElQRjRLVDREOWlYTlpvb0FjVmhCSnkK",
      "endpoints": ["https://github.com/fltuna/perora/releases/latest/download/latest.json"],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
